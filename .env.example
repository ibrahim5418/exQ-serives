# Contact form (POST /api/contact) — sent through Resend.
# Server-side only: these are never bundled into the browser code.
RESEND_API_KEY=
# Optional overrides (defaults shown). The sender must be on a domain verified in Resend.
CONTACT_TO_EMAIL=info@exq.services
CONTACT_FROM_EMAIL="exQ Services <info@exq.services>"

# Cloudflare Turnstile (optional). Set both to switch it on.
# The site key is public and goes to the browser; the secret stays on the server.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
